   "source": [
    "str = input(\"문자열을 입력하세요.\").strip()\n",
    "\n",
    "str_len = len(str)\n",
    "str_type = int(str_len%2)\n",
    "str_mid = str_len // 2\n",
    "\n",
    "if str_len == 0:\n",
    "    print(\"문자를 정확히 입력하세요.\")\n",
    "else:\n",
    "    if str_type == 0:\n",
    "        print(str[str_mid-1], str[str_mid])\n",
    "    else:\n",
    "        print(str[str_mid])"
   ]
  }
