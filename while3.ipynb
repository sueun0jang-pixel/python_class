   "source": [
    "is_continued = True\n",
    "total = 0\n",
    "num = 0\n",
    "\n",
    "while is_continued:\n",
    "    score = int(input(\"성적을 입력하세요.\"))\n",
    "    if score >= 0:\n",
    "        total += score\n",
    "        num += 1\n",
    "    elif score <0:\n",
    "        is_continued = False\n",
    "   \n",
    "\n",
    "print(f'평균은 {total//num}입니다.')"
   ]
  }
