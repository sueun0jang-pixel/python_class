    "## exam2_2.py\n",
    "##### 항공사에서는 짐을 붙일 때 20kg이 넘어가면 20000원의 요금을 받는다.\n",
    "##### 사용자로부터 짐의 무게를 입력 받고 지불해야 할 금액을 계산하세요."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e28f7e39",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "지불해야 할 금액은 0입니다.\n"
     ]
    }
   ],
   "source": [
    "weight = float(input('짐의 무게를 입력하세요.'))\n",
    "fee = 0\n",
    "\n",
    "if weight > 20:\n",
    "    fee = 20000\n",
    "    print(f'지불해야 할 추가 금액은 {fee}입니다.')\n",
    "else:\n",
    "    fee = 0\n",
    "    print(f'지불해야 할 추가 금액은 {fee}입니다.')"
   ]
  }
