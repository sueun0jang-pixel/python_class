   "source": [
    "## if4.py\n",
    "##### 정수를 입력 받아서 짝수인지 홀수인지 출력하는 예제 프로그램입니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "5f3a47cc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "입력하신 숫자는 20이고, 짝수입니다.\n"
     ]
    }
   ],
   "source": [
    "num = int(input('정수를 입력하세요.'))\n",
    "\n",
    "if num % 2 == 0 :\n",
    "    print(f'입력하신 숫자는 {num}이고, 짝수입니다.')\n",
    "else :\n",
    "    print(f'입력하신 숫자는 {num}이고, 홀수입니다.')"
   ]
  }
 ],
