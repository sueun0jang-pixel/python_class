   "source": [
    "def sum(*args):\n",
    "    total = 0\n",
    "    for i in args:\n",
    "        total += i\n",
    "    print(total)\n",
    "\n",
    "sum(1, 2)\n",
    "sum(1, 2, 3)\n",
    "sum(1, 2, 3, 4, 5)"
   ]
  }
