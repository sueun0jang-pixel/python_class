   "source": [
    "## while2.py\n",
    "##### 사용자가 입력한 숫자를 더해서 합을 계산하는 프로그램.\n",
    "##### 입력을 계속할 건지 물어서 yes를 입력하면 다음 숫자 입력, no를 입력하면 합을 출력"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "257a0658",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "210\n"
     ]
    }
   ],
   "source": [
    "user_response = 'yes'\n",
    "total = 0\n",
    "\n",
    "while user_response == 'yes':\n",
    "    user_num = int(input('정수를 입력하세요.'))\n",
    "    total += user_num\n",
    "    user_response = input('계속하시겠습니까?')\n",
    "\n",
    "print(total)\n"
   ]
  }
 ],
