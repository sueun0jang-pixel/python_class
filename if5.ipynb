    "grade = int(input(\"성적을 입력하세요.\"))\n",
    "\n",
    "if grade > 90:\n",
    "    print(\"A\")\n",
    "elif 80 < grade <=90:\n",
    "    print(\"B\")\n",
    "elif 70 < grade <= 80:\n",
    "    print(\"C\")\n",
    "elif 60 < grade <=70:\n",
    "    print(\"D\")\n",
    "elif 50 < grade <=60:\n",
    "    print(\"F\")\n",
    "else:\n",
    "    print(\"끝\")\n"
   ]
