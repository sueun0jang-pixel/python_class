   "source": [
    "## operator1.py\n",
    "##### 산술 연산에 대한 예제\n",
    "\n",
    "##### a = 7\n",
    "##### b = 4"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4d18b67a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7+4 = 11\n",
      "7-4 = 3\n",
      "7*4 = 28\n",
      "7//4 = 1\n",
      "7/4 = 1.75\n",
      "7%4 = 3\n"
     ]
    }
   ],
   "source": [
    "a, b = 7, 4\n",
    "\n",
    "print(f'{a}+{b} = {a + b}')\n",
    "print(f'{a}-{b} = {a - b}')\n",
    "print(f'{a}*{b} = {a * b}')\n",
    "print(f'{a}//{b} = {a // b}')\n",
    "print(f'{a}/{b} = {a / b}')\n",
    "print(f'{a}%{b} = {a % b}')"
   ]
  }
