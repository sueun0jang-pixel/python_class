   "source": [
    "### 두 정수를 키보드로 입력 받아서 사칙 연산을 출력하는 프로그램을 구현하시오. (+, -, *, /)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "ff402239",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a + b : 80\n",
      "a - b : 40\n",
      "a * b : 1200\n",
      "a / b : 3.0\n"
     ]
    }
   ],
   "source": [
    "a = int(input(\"숫자를 입력하세요.\"))\n",
    "b = int(input(\"숫자를 입력하세요.\"))\n",
    "\n",
    "print(f'a + b : {a+b}')\n",
    "print(f'a - b : {a-b}')\n",
    "print(f'a * b : {a*b}')\n",
    "print(f'a / b : {a/b}')\n",
    "\n",
    "\n"
   ]
  }
 ],
