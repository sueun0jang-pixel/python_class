   "source": [
    "## exam3_3.py\n",
    "##### 숫자를 입력 받고, 1부터 입력 받은 수까지의 합을 계산하여 출력하는 프로그램"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "1c4342e3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1부터 5까지의 합은 15입니다.\n"
     ]
    }
   ],
   "source": [
    "user_num = int(input('정수를 입력해주세요.'))\n",
    "total = 0\n",
    "\n",
    "for i in range(1, user_num+1, 1):\n",
    "    total += i\n",
    "\n",
    "print(f'1부터 {user_num}까지의 합은 {total}입니다.')"
   ]
  }
 ],
